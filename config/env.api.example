# Supabase Edge Functions (api)
SUPABASE_URL=https://<project-ref>.supabase.co
SUPABASE_SERVICE_ROLE_KEY=<service-role-key>

GRAPH_CLIENT_ID=<azure-app-client-id>
GRAPH_CLIENT_SECRET=<azure-app-client-secret>
GRAPH_TENANT_ID=<azure-tenant-id>
GRAPH_REDIRECT_URI=https://<project-ref>.functions.supabase.co/graph-oauth-callback
GRAPH_TOKEN_SECRET=<mindestens-32-stelliges-geheimnis>

# SMTP (Alternative zu Microsoft Graph)
SMTP_HOST=smtps.udag.de
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USERNAME=info@<domain>
SMTP_PASSWORD=<smtp-passwort>
SMTP_FROM=info@<domain>
SMTP_FROM_NAME=KusiPrimeTec
